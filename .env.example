# Anthropic API key used by the fundamentals/technicals/sentiment analysts, the
# bull-vs-bear debate, and the synthesizer. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model id passed to every agent call. claude-sonnet-5 balances cost and quality for the
# multi-agent pipeline; the analyst system prompts are cached (Anthropic prompt caching)
# so this should stay pinned unless you're deliberately re-baselining calibration.
ADVISOR_MODEL=claude-sonnet-5

# Alpaca PAPER account keys ONLY — used exclusively by the shadow module to mirror
# recommendations into a paper portfolio for benchmarking against SPY. This repo has
# no live-broker write path; do not put live/production Alpaca keys here.
ALPACA_PAPER_API_KEY=

# Paired secret for the Alpaca PAPER API key above (also paper-trading only).
ALPACA_PAPER_SECRET_KEY=
